        "httpQueryAuth": {
          "id": "4cV6AltE9g1muubI",
          "name": "OMDb API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = items[0].json;\nif (!raw || raw.Response === 'False') {\n  return [{ json: { found: false } }];\n}\nconst ratings = {};\nfor (const r of raw.Ratings || []) {\n  if (r.Source === 'Internet Movie Database') ratings.imdb = r.Value;\n  if (r.Source === 'Rotten Tomatoes') ratings.rottenTomatoes = r.Value;\n  if (r.Source === 'Metacritic') ratings.metacritic = r.Value;\n}\nreturn [{ json: {\n  found: true,\n  title: raw.Title || '',\n  year: raw.Year || '',\n  plot: (raw.Plot && raw.Plot !== 'N/A') ? raw.Plot : null,\n  imdb: ratings.imdb || (raw.imdbRating && raw.imdbRating !== 'N/A' ? raw.imdbRating + '/10' : null),\n  rottenTomatoes: ratings.rottenTomatoes || null,\n  metacritic: ratings.metacritic || null\n} }];"
      },
      "id": "o3",
      "name": "Normalize OMDb",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
