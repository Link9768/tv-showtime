      "parameters": {
        "jsCode": "// Films vus (flaggedWatched = 1) et sÃ©ries avec Ã©pisodes vus (champ watched, dÃ©codÃ© cÃ´tÃ© appli)\nconst lib = Array.isArray($input.first().json.result) ? $input.first().json.result : [];\nconst ok = i => i && !i.removed && /^tt[0-9]+$/.test(String(i._id)) && i.state;\nconst movies = lib.filter(i => ok(i) && i.type === 'movie' && i.state.flaggedWatched === 1).map(i => ({ imdb: i._id, name: i.name, poster: i.poster || '', minutes: i.state.duration ? Math.round(i.state.duration / 60000) : null, lastWatched: i.state.lastWatched || '' }));\nconst series = lib.filter(i => ok(i) && i.type === 'series' && /^tt[0-9]+:/.test(String(i.state.watched || ''))).map(i => ({ imdb: i._id, name: i.name, poster: i.poster || '', watched: i.state.watched, lastWatched: i.state.lastWatched || '' }));\nreturn [{ json: { ok: lib.length > 0, movies, series } }];"
